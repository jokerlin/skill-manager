{
  "name": "skm",
  "version": "0.1.0",
  "description": "Multi-host, multi-agent skill manager: one store, symlinks everywhere, rsync across machines.",
  "type": "module",
  "bin": {
    "skm": "bin/skm.ts"
  },
  "scripts": {
    "test": "bun test",
    "dev": "bun run bin/skm.ts",
